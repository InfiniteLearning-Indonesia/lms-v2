{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:preview": "LMS_DEV_PREVIEW=true LMS_NEXT_DIST_DIR=.next-preview next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "contract:generate": "openapi-typescript contracts/cp11-cp12.openapi.json -o lib/api/generated.ts",
    "contract:check": "node scripts/check-contract.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "check": "npm run assets:check && npm run contract:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-query": "5.90.12",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "next-intl": "4.13.4",
    "next-themes": "^0.4.6",
    "openapi-fetch": "0.14.0",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "7.54.2",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "26.0.0",
    "msw": "2.7.0",
    "openapi-typescript": "7.6.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.0.9"
  }
